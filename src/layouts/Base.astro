---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
const {
  title = "Side Quest Studios",
  description = "Independent game development, creative experimentation, and the journey of bringing imaginary worlds to life.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c11" />
    <title>{title} | Side Quest Studios</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
        import { initializeRevealAnimations } from "../scripts/reveal.js";

        initializeRevealAnimations();
    </script>
  </body>
</html>
