---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog');return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={post.data.title} description={post.data.description}><article class="article container"><a class="back-link" href="/blog/">← All articles</a><span class="eyebrow">{post.data.category}</span><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p><div class="article-date"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time><span>·</span><span>{post.data.readTime || 'Dev journal'}</span></div><div class="article-banner"><span>FIELD NOTES / SIDE QUEST STUDIOS</span><strong>✳</strong></div><div class="prose"><Content/></div><div class="article-end"><a class="text-link" href="/blog/">← Back to the blog</a></div></article></Base>
