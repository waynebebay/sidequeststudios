---
import Base from "../../layouts/Base.astro";
import { authors } from "../../data/authors";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const authorId = post.data.author;

const author =
  authorId && Object.prototype.hasOwnProperty.call(authors, authorId)
    ? authors[authorId as keyof typeof authors]
    : null;
---

<Base title={post.data.title} description={post.data.description}>
  <article class="article container">
    <a class="back-link" href="/blog/">
      ← All articles
    </a>
    <span class="eyebrow">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="article-lead">{post.data.description}</p>
    <div class="article-date">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
        })}
      </time>
      <span>·</span>
      <span>{post.data.readTime || "Dev journal"}</span>
    </div>
    {author && (
      <div class="article-author">
        <img
          src={author.image}
          alt={`${author.name}'s profile picture`}
          class="author-avatar"
          width="44"
          height="44"
          loading="lazy"
        />

        <div class="author-details">
          <span class="author-name">{author.name}</span>
          <span class="author-role">{author.role}</span>
        </div>
      </div>
    )}
    
        <div class:list={["article-banner", { "has-cover": !!post.data.coverImage }]}>
        {post.data.coverImage && (
            <img
            src={post.data.coverImage}
            alt={post.data.title}
            class="article-cover-image"
            />
        )}

        <span>FIELD NOTES / SIDE QUEST STUDIOS</span>

        {!post.data.coverImage && <strong>✳</strong>}
        </div>    <div class="prose">
      <Content />
    </div>
    <div class="article-end">
      <a class="text-link" href="/blog/">
        ← Back to the blog
      </a>
    </div>
  </article>
</Base>
