---
import Base from "../layouts/Base.astro";
---

<Base title="Transmission Complete">
  <section class="container transmission-section">

    <div class="transmission-panel reveal">

      <div class="transmission-icon">✓</div>

      <span class="eyebrow">SIDE QUEST STUDIOS // COMMUNICATIONS</span>

      <h1>Transmission <em>Complete.</em></h1>

      <p class="transmission-description">
        Your message has been successfully transmitted to Side Quest Studios.
        We'll get back to you as soon as possible.
      </p>

      <div class="transmission-status">
        <div class="transmission-status-header">
          <span>TRANSMISSION STATUS</span>
          <span>100%</span>
        </div>

        <div class="transmission-progress">
          <div class="transmission-progress-fill"></div>
        </div>

        <div class="transmission-status-footer">
          <span>PACKETS DELIVERED</span>
          <span class="status-success">● COMPLETE</span>
        </div>
      </div>

      <a href="/" class="button primary transmission-button">
        Return to Home →
      </a>

    </div>

  </section>
</Base>