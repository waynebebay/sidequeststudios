---
import Base from "../layouts/Base.astro";
---

<Base title="Contact">
  <section class="page-intro container">
    <span class="eyebrow">SAY HELLO</span>
    <h1 class="reveal">
      Every good quest starts
      <br />
      with a <em>conversation.</em>
    </h1>
    <p class="reveal reveal-delay-2">
      Have a question, collaboration idea, or just want to talk game
      development? We'd love to hear from you.
    </p>
  </section>
  <section class="container section-tight reveal reveal-delay-3">
    <div class="contact-panel">
  <span class="eyebrow">GET IN TOUCH</span>
  <h2>Let's make something interesting.</h2>

  <p>
    Have a question, collaboration idea, or just want to talk
    game development? Send us a message!
  </p>

  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/contact-success/"
    class="contact-form"
  >
    <input type="hidden" name="form-name" value="contact" />

    <!-- Spam protection -->
    <p hidden>
      <label>
        Don't fill this out:
        <input name="bot-field" />
      </label>
    </p>

    <div class="form-group">
      <label for="contact-name">NAME</label>
      <input
        type="text"
        id="contact-name"
        name="name"
        placeholder="Your name"
        required
      />
    </div>

    <div class="form-group">
      <label for="contact-email">EMAIL</label>
      <input
        type="email"
        id="contact-email"
        name="email"
        placeholder="your@email.com"
        required
      />
    </div>

    <div class="form-group">
      <label for="contact-subject">SUBJECT</label>
      <input
        type="text"
        id="contact-subject"
        name="subject"
        placeholder="Collaboration, feedback, general inquiry..."
        required
      />
    </div>

    <div class="form-group">
      <label for="contact-message">MESSAGE</label>
      <textarea
        id="contact-message"
        name="message"
        placeholder="What's on your mind?"
        rows="6"
        required
      ></textarea>
    </div>

    <button type="submit" class="button primary">
      Send Message
    </button>
  </form>
</div>
  </section>
</Base>
