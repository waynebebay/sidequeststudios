---
import Base from "../../layouts/Base.astro";
---

<Base title="Projects">
  <section class="page-intro container">
    <span class="eyebrow">OUR WORLDS</span>
    <h1 class="reveal">
      Projects built on <em>curiosity.</em>
    </h1>
    <p class="reveal reveal-delay-2">
      Small teams can still dream up enormous places. Here's what we're
      building.
    </p>
  </section>
  <section class="container section-tight">
    <a class="project-listing reveal reveal-delay-3" href="/projects/meridian/">
      <div class="project-listing-art">
        <span>PROJECT / 001</span>
        <strong>MERIDIAN</strong>
      </div>
      <div>
        <span class="tag violet">IN DEVELOPMENT</span>
        <h2>Project Meridian</h2>
        <p>
          A strange world, a forgotten facility, and systems waiting to be
          understood. An Unreal Engine 5 project rooted in discovery and
          environmental storytelling.
        </p>
        <span class="text-link">Explore Project Meridian →</span>
      </div>
    </a>
  </section>
</Base>
