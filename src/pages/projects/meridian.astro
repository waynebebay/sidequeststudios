---
import Base from "../../layouts/Base.astro";
---

<Base title="Project Meridian">
  <section class="meridian-hero">
    <div class="container">
      <span class="eyebrow boxed">PROJECT 001 · IN DEVELOPMENT</span>
      <h1 class="reveal">
        PROJECT
        <br />
        <em>MERIDIAN</em>
      </h1>
      <p class="reveal reveal-delay-2">
        A world of strange technology, forgotten stories, and unexpected
        discoveries.
      </p>
    </div>
  </section>
  <section class="section container two-col">
    <div>
      <span class="eyebrow">ABOUT THE PROJECT</span>
      <h2>
        Every world has
        <br />a story to tell.
      </h2>
    </div>
    <div>
      <p>
        Project Meridian is an independent game project developed in Unreal
        Engine 5. Its environments, interactive systems, and worldbuilding are
        designed to reward exploration and curiosity.
      </p>
      <p>
        Follow the development journal for a closer look at the G.R.A.C.E.
        facility, experimental materials, interactive terminals, and the process
        of bringing Urph to life.
      </p>
      <a class="button primary" href="/blog/">
        Read development updates →
      </a>
    </div>
  </section>
  <section class="section philosophy">
    <div class="container">
      <span class="eyebrow">WORK IN PROGRESS</span>
      <h2>More to discover.</h2>
      <p class="muted">
        Screenshots, gameplay footage, and detailed project updates will be
        added as development continues.
      </p>
    </div>
  </section>
</Base>
